# Секреты для бэкапа Postgres → Reg.ru S3.
# На VPS: /opt/miraflores/deploy/backup-s3.env  (chmod 600)
# НЕ коммитить.

AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

S3_ENDPOINT=https://s3.regru.cloud
S3_BUCKET=miraflores-db
S3_PREFIX=postgres

# Регион для AWS CLI (у Reg.ru часто достаточно us-east-1)
AWS_DEFAULT_REGION=us-east-1

DB_CONTAINER=miraflores_db
POSTGRES_USER=miraflores
POSTGRES_DB=miraflores

# Сколько дней хранить дампы в бакете (0 = не чистить)
KEEP_DAYS=30

# Reg.ru: при SSL CERTIFICATE_VERIFY_FAILED поставьте 1
S3_NO_VERIFY_SSL=1

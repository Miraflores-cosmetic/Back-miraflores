NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Socket.IO order-chat (по умолчанию origin из NEXT_PUBLIC_API_URL; на prod — https://miraflores-shop.com)
# NEXT_PUBLIC_SOCKET_ORIGIN=https://miraflores-shop.com
NEXT_PUBLIC_SITE_URL=http://localhost:3010
# Telegram channel (footer). If empty — link goes to /contacts
NEXT_PUBLIC_TELEGRAM_URL=
# Яндекс.Карты JS API (адрес / ПВЗ / курьер на checkout)
NEXT_PUBLIC_YANDEX_MAP_API_KEY=
# Яндекс Доставка B2B (Bearer из dostavka.yandex.ru, обычно y0__…)
YANDEX_DELIVERY_TOKEN=
# Platform pricing: station_id склада (из POST .../platform/warehouses/list)
YANDEX_PLATFORM_SOURCE_STATION_ID=
# Для warehouses-list (не путать с «ID клиента» в ЛК)
YANDEX_PLATFORM_MERCHANT_ID=
# Склад отправителя (Cargo fallback; иначе дефолт СПб в коде)
YANDEX_DELIVERY_WAREHOUSE_LAT=
YANDEX_DELIVERY_WAREHOUSE_LNG=
YANDEX_DELIVERY_WAREHOUSE_FULLNAME=
YANDEX_DELIVERY_WAREHOUSE_ID=
# СДЭК API (oauth client_id / client_secret) — BFF /api/cdek
CDEK_ACCOUNT=
CDEK_SECURE=
# Точка сдачи MSK12 и CDEK_FROM_CITY_CODE=44 — в backend/.env (создание отправлений + server quote).
# Тот же секрет, что в backend; URL вебхука в ЮKassa: /api/yookassa/webhook?secret=...
YOOKASSA_WEBHOOK_SECRET=
# IP allowlist на Next (в production по умолчанию вкл.). 0 — выкл. для локальных тестов.
YOOKASSA_WEBHOOK_CHECK_IP=

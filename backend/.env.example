PORT=3001
DATABASE_URL="postgresql://miraflores:miraflores@localhost:5432/miraflores?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
FRONTEND_PUBLIC_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:3000"
ADMIN_SEED_EMAIL="admin@miraflores-shop.com"
ADMIN_SEED_PASSWORD="change-me-admin"
# ЮKassa (embedded widget на /checkout)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Секрет в URL вебхука: https://site/api/yookassa/webhook?secret=...
YOOKASSA_WEBHOOK_SECRET=
# IP allowlist ЮKassa на Nest (обычно не нужен — проверка на Next). 1/true — вкл.
YOOKASSA_WEBHOOK_CHECK_IP=
# Авто-отмена AWAITING_PAYMENT старше N минут (default 60)
ORDER_AWAITING_TTL_MINUTES=60
# HMAC-секрет short-lived payToken (в production обязателен и ≠ JWT_SECRET)
ORDER_PAY_SECRET=
# TTL подписанного shipping quote (сек), default 900
# SHIPPING_QUOTE_TTL_SECONDS=900

# Staff ACL cache (horizontal scale): redis://127.0.0.1:6379 — shared между API-инстансами.
# Без REDIS_URL — in-memory 30s per process (+ tokenVersion bump при мутациях).
# REDIS_URL=redis://127.0.0.1:6379

# Локальные картинки (без S3): файлы в backend/.data/local-uploads → http://host:3001/uploads/...
LOCAL_UPLOADS_DIR=
LOCAL_UPLOADS_PUBLIC_URL="http://127.0.0.1:3001"

# PostgreSQL RLS (миграция rls_user_owned): Nest выставляет app.user_id / app.rls_bypass
# на каждый запрос. Покупатель — только свои User/Address/Order*; staff и public — bypass.

# SMTP Miraflores (Yandex Mail for Domain). Без SMTP_PASSWORD письма не уходят.
# Не подставлять учётку Jcos (julie-group). Публичный контакт: info@miraflores.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FORCE_IPV4=1
# На порту 587: SMTP_SECURE=false; при проблемах со STARTTLS — SMTP_REQUIRE_TLS=0
# SMTP_REQUIRE_TLS=0
SMTP_USER=Mira-robot@miraflores-shop.ru
SMTP_PASSWORD=
MAIL_FROM="Miraflores <Mira-robot@miraflores-shop.ru>"
MAIL_REPLY_TO=info@miraflores.ru
# За nginx: hop count для Express trust proxy (default 1). Локально без proxy: TRUST_PROXY=0
TRUST_PROXY=1
# CompletionToken регистрации (OTP → complete).
# Production: обязателен, сильный, НЕ равный JWT_SECRET (иначе API не стартует).
# Local: можно пустым → возьмётся JWT_SECRET / dev-secret.
REGISTRATION_TOKEN_SECRET=

# СДЭК — автосоздание отправления из админки (POST orders/admin/:id/ship без трека)
# Те же ключи, что у Front proxy /api/cdek. Без них ship работает локально (только статус).
CDEK_ACCOUNT=
CDEK_SECURE=
# Код склада сдачи (shipment_point). Если пусто — from_location по CDEK_FROM_CITY_CODE
CDEK_SHIPMENT_POINT=
CDEK_FROM_CITY_CODE=44
# Тарифы: 136 склад-склад, 137 склад-дверь (по умолчанию)
# CDEK_TARIFF_PVZ=136
# CDEK_TARIFF_DOOR=137

# LLM-ассистент админки (GPTunnel OpenAI-compatible)
# Ключ только на Nest. Authorization без префикса Bearer.
GPTUNNEL_API_KEY=
GPTUNNEL_BASE_URL=https://gptunnel.ru/v1
ASSISTANT_MODEL=gpt-4.1-mini
# Лимит completion tokens на один вызов модели (дефолт 2048)
ASSISTANT_MAX_TOKENS=2048

# 1С обмен (Битрикс-протокол CommerceML)
# URL для 1С: https://miraflores-shop.com/api/v1/1c/exchange
# Логин/пароль ПРИДУМЫВАЕТЕ сами (не из 1С) — те же значения указать
# в настройках «Обмен с сайтом» в 1С. Без них эндпоинт отвечает 401.
ONEC_LOGIN=
ONEC_PASSWORD=
# Импорт offers.xml (цены/остатки 1С → сайт). 0 = только заказы site → 1C (рекомендуется).
ONEC_CATALOG_IMPORT=0
# Выгружать отменённые/возвраты в 1С. 0 = только PAID…DELIVERED.
# ONEC_EXPORT_CANCELLED=0
# Каталог временных файлов обмена (default: backend/.data/1c-exchange)
# ONEC_EXCHANGE_DIR=

# Разово проставить onecId по offers.xml (из backend/):
#   npm run prisma:fill-onec-ids -- /path/to/offers.xml --dry-run
#   npm run prisma:fill-onec-ids -- /path/to/offers.xml

